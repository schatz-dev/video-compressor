{
    "name": "video-compressor",
    "version": "1.0.0",
    "description": "Desktop video compression app powered by Electron and FFmpeg",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "keywords": [
        "electron",
        "ffmpeg",
        "video-compressor"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "ffmpeg-static": "^5.2.0",
        "ffprobe-static": "^3.1.0",
        "fluent-ffmpeg": "^2.1.3"
    },
    "devDependencies": {
        "electron": "^30.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.videocompressor.app",
        "productName": "Video Compressor",
        "files": [
            "**/*"
        ],
        "win": {
            "target": "nsis"
        }
    }
}